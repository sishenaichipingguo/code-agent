# Environment variables
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_MODE=yolo

# OpenAI-compatible providers (OpenAI, LM Studio, llama.cpp, vLLM, OpenRouter, Groq).
# Used when provider is "openai" or "openai-compatible" in .agent.yml.
# OPENAI_API_KEY can be any placeholder for keyless local servers.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:1234/v1
